# Copy to .env (never committed) and fill in. A dry run (python bot.py) needs none of it.

# demo: Kalshi's demo exchange, fake money (demo.kalshi.co). prod: real money.
KALSHI_ENV=demo

# From kalshi.com/account/profile > API Keys (a separate key on demo.kalshi.co for demo).
KALSHI_API_KEY_ID=
# Full path to the private key file Kalshi gave you, e.g. /path/to/bot/keys/kalshi.pem (keys/ is ignored by git).
KALSHI_PRIVATE_KEY_PATH=

# Phone alerts (python -m kalshi_bot.notify): the ntfy topic you subscribe to in the ntfy app. On ntfy.sh's free server
# the name is the only lock, so make it long and random, e.g. python -c "import secrets; print('kalshi-' + secrets.token_urlsafe(18))"
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# Optional: the healthchecks.io check's ping address for python -m kalshi_bot.watchdog (the dead man's switch).
# Unset: no pings.
# HEALTHCHECK_URL=https://hc-ping.com/<your-check-uuid>
